# Copy this file to .env and fill in your own key. .env is git-ignored.

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the model if Google renames/deprecates this one.
# Check https://ai.google.dev/gemini-api/docs/models for the current free-tier model name.
GEMINI_MODEL=gemini-2.0-flash

PORT=3000
